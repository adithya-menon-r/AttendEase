{
  "manifest_version": 3,
  "name": "AttendEase",
  "version": "2.1.0",
  "description": "Shows how many classes you can skip, or need to attend to reach your target attendance.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://students.amrita.edu/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://students.amrita.edu/client/class-attendance*"
      ],
      "js": [
        "src/calc.js",
        "src/scrape.js",
        "src/absent.js",
        "src/widget-css.js",
        "src/widget.js",
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "assets/attend-ease-16.png",
    "48": "assets/attend-ease-48.png",
    "128": "assets/attend-ease-128.png"
  },
  "action": {
    "default_title": "AttendEase",
    "default_icon": {
      "16": "assets/attend-ease-16.png",
      "48": "assets/attend-ease-48.png",
      "128": "assets/attend-ease-128.png"
    }
  }
}
